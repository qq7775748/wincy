{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wincy",
  "version": "0.2.5",
  "identifier": "app.wincy.clipboard",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Wincy",
        "url": "index.html",
        "width": 480,
        "height": 540,
        "minWidth": 360,
        "minHeight": 300,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "backgroundThrottling": "disabled",
        "skipTaskbar": true,
        "visible": false,
        "focus": true,
        "center": true
      },
      {
        "label": "settings",
        "title": "Wincy 设置",
        "url": "settings.html",
        "width": 480,
        "height": 700,
        "minWidth": 420,
        "minHeight": 420,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": false,
        "skipTaskbar": true,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
